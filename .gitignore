# Laravel generated dirs: keep folder placeholders so fresh clones work,
# ignore everything else inside them
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore

# Database dumps
db_desa.sql
*.sqlite
*.sqlite3

# NPM/Yarn debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local tools & config
boost.json
skills-lock.json

# File debugging sensitif - jangan di-upload ke GitHub
check_creds.php
clear_sessions.php
bootstrap.zip

# Konfigurasi AI Agent (Antigravity IDE) - lokal saja
/.agents

# Non-kode aplikasi - lokal saja (tetap ada di disk, tidak di-upload ke GitHub)
/docs
/AGENTS.md
/tests